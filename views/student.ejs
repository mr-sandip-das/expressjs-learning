<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Data is Hear</h1>
    <table border="1">
        <tr>
            <td>Name</td>
            <td>Age</td>
            <td>Email</td>
            <td>Delete</td>
        </tr>

        
            <% result.forEach((value)=>{ %>
                <tr>
                <td><%=  value.name %></td>
                <td><%=  value.age %></td>
                <td><%=  value.email %></td>
                <td><a href="ui/delete/<%=  value._id %>">delete</a></td>
                </tr>
                <% }); %>


    </table>
</body>

</html>